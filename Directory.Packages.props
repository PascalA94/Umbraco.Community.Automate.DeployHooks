<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- The latest CI leg restores floating $(AutomateMajor).* versions (AutomateFloat=true). -->
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
    <!-- Lets the pins below raise vulnerable transitive packages that Umbraco and Automate bring in. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Umbraco. Ranges are closed at both ends and never open-ended; see Directory.Build.props. -->
  <ItemGroup>
    <PackageVersion Include="Umbraco.Automate.Core" Version="$(AutomateVersionSpec)" />
    <PackageVersion Include="Umbraco.Automate.Testing" Version="$(AutomateVersionSpec)" />
    <!-- Test-only: the credential isolation suite (I06, I07) runs Automate's real registration and scans every assembly a site loads. -->
    <PackageVersion Include="Umbraco.Automate.Persistence" Version="$(AutomateVersionSpec)" />
    <PackageVersion Include="Umbraco.Automate.Startup" Version="$(AutomateVersionSpec)" />
    <PackageVersion Include="Umbraco.Automate.Web" Version="$(AutomateVersionSpec)" />
    <PackageVersion Include="Umbraco.Cms.Core" Version="$(UmbracoCmsVersionSpec)" />
    <PackageVersion Include="Umbraco.Cms.Infrastructure" Version="$(UmbracoCmsVersionSpec)" />
    <PackageVersion Include="Umbraco.Cms.Tests.Integration" Version="$(UmbracoTestVersion)" />
  </ItemGroup>

  <!--
    Transitive pins, copied from Jira (same Umbraco and Automate floors). They are referenced with PrivateAssets="all",
    so they fix this repo's own restore and audit but never reach consumers as open-ended dependencies.
    Re-check on every Automate or CMS bump with build/check-vulnerable.sh; delete a pin once upstream has caught up
    (a stale pin below what upstream needs fails restore with NU1109, so it cannot hide).
      MessagePack 3.1.11                         GHSA-qhrr-8q5h-9q3h (moderate), fixed in 3.1.9; 3.1.11 is what Umbraco.Cms.Tests.Integration 18.3.0 needs
      OpenTelemetry.Api 1.15.3                   GHSA-g94r-2vxg-569j (moderate), fixed in 1.15.3
      System.Security.Cryptography.Xml 10.0.13   GHSA-r955-8q5j-3h83, GHSA-7hqp-7c5m-4vq6, GHSA-c399-9853-6jmj (high), fixed in 10.0.13
  -->
  <ItemGroup>
    <PackageVersion Include="MessagePack" Version="3.1.11" />
    <PackageVersion Include="OpenTelemetry.Api" Version="1.15.3" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="1.1.1" />
  </ItemGroup>

  <!-- Test stack (template versions). -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <!-- NUnit 3.14: the version Umbraco.Cms.Tests is built against; NUnit 4 is not binary compatible with it. -->
    <PackageVersion Include="NUnit" Version="3.14.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
</Project>
